<?xml version="1.0" encoding="utf-8"?>
<!--
    사진 위에 얹는 한 겹. 위쪽 절반은 40% 어둠으로 고르게 덮어 시각·날짜의 대비를 확보하고,
    아래쪽 절반은 바탕색(alarm_night)까지 짙어지며 사라진다 — 그래서 사진이 끝나는 자리에
    경계선이 보이지 않는다.

    angle=90은 아래에서 위로 간다. 그래서 startColor가 사진 맨 아래(불투명 바탕색)다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/alarm_night"
        android:centerColor="@color/alarm_photo_veil"
        android:endColor="@color/alarm_photo_veil"
        android:type="linear" />
</shape>
