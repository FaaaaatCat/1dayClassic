<?xml version="1.0" encoding="utf-8"?>
<!--
    잠금화면 알람 화면. 피그마 VariantA(2145:798, 375×812) 기준.

    이미지 두 장은 XML에 박아 두지 않고 AlarmActivity가 파일에서 읽어 넣는다 — 책이 227권까지
    늘어날 예정이라 res/drawable에 다 넣을 수 없고, 알람에 필요한 건 늘 '지금 고른 책' 한 벌뿐이다.
    파일이 없으면 배경은 밤색으로, 표지는 빈 자리로 남는다(레이아웃은 그대로 유지된다).

    세로 위치는 피그마의 절대 좌표(top 106 / 519)가 아니라 위아래 Space의 가중치로 잡았다.
    화면 비율이 다른 기기에서도 표지가 가운데 오고 버튼이 아래에 붙어 있어야 하기 때문이다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_night">

    <!--
        사진은 화면 위쪽 절반만 덮는다(디자인 375×406 = 812의 50%). 아래 절반은 바탕색이라,
        화면 비율이 다른 기기에서는 사진이 잘리는 대신 단색 영역이 늘고 줄어든다.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/alarm_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                tools:src="@color/alarm_night" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/alarm_photo_fade" />
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="106dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/alarm_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textSize="70sp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.025"
            android:textColor="@color/alarm_violet_5"
            android:gravity="center_horizontal"
            tools:text="07:30" />

        <TextView
            android:id="@+id/alarm_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:fontFamily="sans-serif"
            android:textSize="14sp"
            android:letterSpacing="0"
            android:textColor="@color/alarm_on_dark"
            android:gravity="center_horizontal"
            tools:text="11월 26일 금요일" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
            표지 자리 — 세워 둔 책 한 권(AlarmCoverView).

            뷰가 원근을 dp로 셈해, 세운 무대를 이 자리의 90% 안에 스스로 맞춘다.
            앞표지 폭은 대략 130dp 남짓이 된다.
        -->
        <expo.modules.alarmclock.AlarmCoverView
            android:id="@+id/alarm_book"
            android:layout_width="156dp"
            android:layout_height="236dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/alarm_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:fontFamily="serif"
            android:textSize="22sp"
            android:letterSpacing="-0.1"
            android:lineSpacingMultiplier="1"
            android:textColor="@color/alarm_on_dark"
            android:gravity="center_horizontal"
            tools:text="하루 클래식 공부할\n시간입니다" />

        <!--
            디자인의 보라색 글로우(0 8px 16px rgba(120,70,255,.45))는 넣지 않았다.
            Android의 elevation 그림자는 색을 그렇게 못 내고, 거의 검정인 배경 위에서는
            어차피 보이지 않는다. 필요해지면 블러 이미지를 뒤에 까는 방식으로 따로 붙일 것.
        -->
        <Button
            android:id="@+id/button_dismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/alarm_button_primary"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="공부하기"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:letterSpacing="0.0625"
            android:textColor="@color/alarm_on_dark"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_snooze"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/alarm_button_secondary"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="5분 후 다시 알림"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:letterSpacing="0.036"
            android:textColor="@color/alarm_button_label" />

        <!--
            배경 사진 출처 — 다시 알림 버튼 아래 맨 끝에 작게 둔다. 사진 위에 얹었더니 표지 옆에
            붙어 책의 글처럼 읽혔다. 배경이 없는 책에서는 AlarmActivity가 숨긴다.
        -->
        <TextView
            android:id="@+id/alarm_credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:fontFamily="sans-serif"
            android:textSize="10sp"
            android:letterSpacing="0.04"
            android:alpha="0.55"
            android:textColor="@color/alarm_on_dark"
            tools:text="사진 Geert Pieters · Unsplash" />
    </LinearLayout>

    <!--
        디자인 확인용 미리보기에서만 보이는 줄. 실제 알람에서는 gone이다 —
        알람 화면은 끄기/스누즈 말고는 빠져나갈 길이 없어야 한다.
        맨 마지막 자식이라 다른 무엇보다 위에 그려진다.
    -->
    <LinearLayout
        android:id="@+id/preview_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!--
            빌드가 실제로 갱신됐는지 눈으로 구별하기 위한 표식. 레이아웃을 고칠 때마다
            숫자를 올린다 — 이게 안 바뀌면 재빌드가 안 된 것이다.
        -->
        <TextView
            android:id="@+id/preview_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="ver.4"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/alarm_debug" />

        <TextView
            android:id="@+id/preview_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="22sp"
            android:textColor="@color/alarm_on_dark"
            android:contentDescription="@string/alarm_preview_close" />
    </LinearLayout>

</FrameLayout>
